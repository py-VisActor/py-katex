        "--visual",
        "{repo}/test-runs/MATH-FULL-batch-20261105T171857Z-5071cad7",
        "--legacy",
        "{repo}/test-runs/MATH-FULL-batch-20261105T171629Z-8b5ef28e",
        "--manual-receipt",
        "{repo}/docs/changes/math-full-layout-visual-qa-accepted.json",
        "--manual-receipt",
        "{repo}/docs/changes/math-full-canvas-visual-qa-accepted.json",
