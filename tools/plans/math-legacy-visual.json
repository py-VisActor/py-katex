{
  "schema": "py-mermaid-command-plan/v1",
  "scope": "MATH",
  "description": "All 297 historical positive graphs x3 profiles; all negative/source/scope IDs retained. Two historical math exclusions now verify genuine math content/pixels under explicit promotedMath assertion, never skip. No install.",
