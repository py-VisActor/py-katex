      "name": "historical-fixtures-with-explicit-math-promotion",
      "argv": [
        "{python}",
        "-c",
        "import json,sys;from pathlib import Path;sys.path.insert(0,'tools');from run_support import write_json;root=Path(sys.argv[1])/'artifacts';[(root/name).mkdir() for name in ['f011','f012','f013','f014']];[(write_json(root/name/'cases.json',json.loads((Path('../py-mermaid/tests')/name/'cases.json').read_text('utf-8')))) for name in ['f011','f012','f013','f014']];[( (lambda path,data:( [(c.update(promotedMath={'formulas':['x^2'],'glyphs':['x','2']},scopeDisposition='implemented_by_math_module')) for c in data.get('unsupportedCases',[]) if c['id'] in ['math','math-separate']],write_json(path,data)))(root/name/'cases.json',json.loads((root/name/'cases.json').read_text('utf-8')))) for name in ['f013','f014']]",
        "{run}"
      ],
      "timeoutSeconds": 60
    },
    {
      "name": "f011-verified-source-reuse",
      "argv": [
        "{python}",
        "{repo}/../py-mermaid/tools/reuse_oracle.py",
