{
  "schema": "py-mermaid-command-plan/v1",
  "scope": "RELEASE",
  "description": "Rebuild py-visactor-katex 0.1.0 after PyPI similarity rejection; preserve import py_katex and reviewed runtime. Verify actual new wheel/sdist installs on CPU/auto/GPU.",
  "steps": [
    {
      "name": "build-wheel-and-sdist",
      "argv": [
        "{repo}/.local/release-tools-0.1.0/Scripts/python.exe",
        "-I",
        "-m",
        "build",
        "--no-isolation",
        "--outdir",
        "{run}/artifacts/dist"
      ],
      "timeoutSeconds": 300
    },
    {
      "name": "strict-pypi-metadata",
      "argv": [
        "{repo}/.local/release-tools-0.1.0/Scripts/python.exe",
        "-I",
        "-m",
        "twine",
        "check",
        "--strict",
        "{run}/artifacts/dist/py_visactor_katex-0.1.0-py3-none-any.whl",
        "{run}/artifacts/dist/py_visactor_katex-0.1.0.tar.gz"
      ],
      "timeoutSeconds": 120
    },
    {
      "name": "release-runtime-payload-and-external-install",
      "argv": [
        "{python}",
        "{repo}/tools/release_artifacts.py",
        "--wheel",
        "{run}/artifacts/dist/py_visactor_katex-0.1.0-py3-none-any.whl",
        "--sdist",
        "{run}/artifacts/dist/py_visactor_katex-0.1.0.tar.gz",
        "--install",
        "--backend",
        "cpu",
        "--backend",
        "auto",
        "--backend",
        "gpu",
        "--out",
        "{run}/artifacts/validation"
      ],
      "timeoutSeconds": 1200
    },
    {
      "name": "test-api",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "{repo}/tests",
        "-p",
        "test_api.py",
        "-v"
      ],
      "env": {
        "PYTHONPATH": "{repo}/src",
        "PYTHONUTF8": "1"
      },
      "timeoutSeconds": 180
    },
    {
      "name": "test-full-api",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "{repo}/tests",
        "-p",
        "test_full_api.py",
        "-v"
      ],
      "env": {
        "PYTHONPATH": "{repo}/src",
        "PYTHONUTF8": "1"
      },
      "timeoutSeconds": 180
    }
  ]
}
