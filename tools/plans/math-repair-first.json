{
  "schema": "py-mermaid-command-plan/v1",
  "scope": "MATH",
  "description": "Target first preserved integration/public namespace failures only; source owners may still repair their independent source families",
  "steps": [
    {
      "name": "math-canvas-after-public-api-fix",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "{repo}/tests",
        "-p",
        "test_canvas.py",
        "-v"
      ],
      "env": {
        "PYTHONPATH": "{repo}/src;{repo}/../py-mermaid/src",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "timeoutSeconds": 600
    },
    {
      "name": "mermaid-math-after-parser-gates",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "{repo}/../py-mermaid/tests/math",
        "-v"
      ],
      "env": {
        "PYTHONPATH": "{repo}/src;{repo}/../py-mermaid/src",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "timeoutSeconds": 600
    },
    {
      "name": "native-cpu-after-integration-fix",
      "argv": [
        "{python}",
        "{repo}/tools/validate_math.py",
        "--fixtures",
        "{repo}/tests/cases.json",
        "--oracle",
        "{repo}/test-runs/MATH-batch-20261105T120246Z-de639d13/artifacts/oracle",
        "--out",
        "{run}/artifacts/compare-cpu",
        "--backend",
        "cpu"
      ],
      "env": {
        "PYTHONPATH": "{repo}/src;{repo}/../py-mermaid/src",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "timeoutSeconds": 600
    }
  ]
}
