{
  "schema": "py-mermaid-command-plan/v1",
  "scope": "MATH",
  "description": "61 standalone math and 8 real Mermaid graphs on CPU/auto/GPU with immutable official reference reuse, no installation",
  "inputs": [
    "{repo}/tests/cases.json",
    "{repo}/tests/integration-cases.json"
  ],
  "steps": [
    {
      "name": "joint-source-snapshot",
      "argv": [
        "{python}",
        "{repo}/tools/joint_candidate.py",
        "--out",
        "{run}/artifacts"
      ],
      "timeoutSeconds": 120
    },
    {
      "name": "verified-official-math-reuse",
      "argv": [
        "{python}",
        "-c",
        "import json,shutil,sys;from pathlib import Path;sys.path.insert(0,'tools');from run_support import file_identity;root=Path('test-runs/MATH-batch-20261105T120246Z-de639d13');run=json.loads((root/'run.json').read_text('utf-8'));assert file_identity(Path('tests/cases.json'))==run['inputs'][str(Path('tests/cases.json').resolve())];target=Path(sys.argv[1])/'artifacts/oracle';shutil.copytree(root/'artifacts/oracle',target);[(None if file_identity(target/p.name)==file_identity(p) else (_ for _ in ()).throw(ValueError('Copied oracle changed'))) for p in (root/'artifacts/oracle').iterdir()];print('Copied all fixed-source oracle files byte-for-byte; exact case fixture fingerprint unchanged')",
        "{run}"
      ],
      "timeoutSeconds": 120
    },
    {
      "name": "verified-official-integration-reuse",
      "argv": [
        "{python}",
        "-c",
        "import json,shutil,sys;from pathlib import Path;sys.path.insert(0,'tools');from run_support import file_identity;root=Path('test-runs/MATH-batch-20261105T121539Z-8cf07304');run=json.loads((root/'run.json').read_text('utf-8'));assert file_identity(Path('tests/integration-cases.json'))==run['inputs'][str(Path('tests/integration-cases.json').resolve())];target=Path(sys.argv[1])/'artifacts/integration-oracle';shutil.copytree(root/'artifacts/integration-oracle',target);assert all(file_identity(target/p.name)==file_identity(p) for p in (root/'artifacts/integration-oracle').iterdir());print('All eight official graph captures reused unchanged with exact fixture input fingerprint')",
        "{run}"
      ],
      "timeoutSeconds": 600
    },
    {
      "name": "math-standalone-cpu",
      "argv": [
        "{python}",
        "{repo}/tools/validate_math.py",
        "--fixtures",
        "{repo}/tests/cases.json",
        "--oracle",
        "{run}/artifacts/oracle",
        "--out",
        "{run}/artifacts/standalone-cpu",
        "--backend",
        "cpu"
      ],
      "env": {
        "PYTHONPATH": "{repo}/src;{repo}/../py-mermaid/src;{repo}/../py-mermaid/tools",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "timeoutSeconds": 1200
    },
    {
      "name": "math-integration-cpu",
      "argv": [
        "{python}",
        "{repo}/tools/validate_integration.py",
        "--fixtures",
        "{repo}/tests/integration-cases.json",
        "--oracle",
        "{run}/artifacts/integration-oracle",
        "--out",
        "{run}/artifacts/integration-cpu",
        "--backend",
        "cpu"
      ],
      "env": {
        "PYTHONPATH": "{repo}/src;{repo}/../py-mermaid/src;{repo}/../py-mermaid/tools",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "timeoutSeconds": 1200
    },
    {
      "name": "math-standalone-auto",
      "argv": [
        "{python}",
        "{repo}/tools/validate_math.py",
        "--fixtures",
        "{repo}/tests/cases.json",
        "--oracle",
        "{run}/artifacts/oracle",
        "--out",
        "{run}/artifacts/standalone-auto",
        "--backend",
        "auto"
      ],
      "env": {
        "PYTHONPATH": "{repo}/src;{repo}/../py-mermaid/src;{repo}/../py-mermaid/tools",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "timeoutSeconds": 1200
    },
    {
      "name": "math-integration-auto",
      "argv": [
        "{python}",
        "{repo}/tools/validate_integration.py",
        "--fixtures",
        "{repo}/tests/integration-cases.json",
        "--oracle",
        "{run}/artifacts/integration-oracle",
        "--out",
        "{run}/artifacts/integration-auto",
        "--backend",
        "auto"
      ],
      "env": {
        "PYTHONPATH": "{repo}/src;{repo}/../py-mermaid/src;{repo}/../py-mermaid/tools",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "timeoutSeconds": 1200
    },
    {
      "name": "math-standalone-gpu",
      "argv": [
        "{python}",
        "{repo}/tools/validate_math.py",
        "--fixtures",
        "{repo}/tests/cases.json",
        "--oracle",
        "{run}/artifacts/oracle",
        "--out",
        "{run}/artifacts/standalone-gpu",
        "--backend",
        "gpu"
      ],
      "env": {
        "PYTHONPATH": "{repo}/src;{repo}/../py-mermaid/src;{repo}/../py-mermaid/tools",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "timeoutSeconds": 1200
    },
    {
      "name": "math-integration-gpu",
      "argv": [
        "{python}",
        "{repo}/tools/validate_integration.py",
        "--fixtures",
        "{repo}/tests/integration-cases.json",
        "--oracle",
        "{run}/artifacts/integration-oracle",
        "--out",
        "{run}/artifacts/integration-gpu",
        "--backend",
        "gpu"
      ],
      "env": {
        "PYTHONPATH": "{repo}/src;{repo}/../py-mermaid/src;{repo}/../py-mermaid/tools",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "timeoutSeconds": 1200
    },
    {
      "name": "joint-source-unchanged",
      "argv": [
        "{python}",
        "{repo}/tools/joint_candidate.py",
        "--check",
        "{run}/artifacts/joint-candidate.json"
      ],
      "timeoutSeconds": 60
    }
  ]
}
