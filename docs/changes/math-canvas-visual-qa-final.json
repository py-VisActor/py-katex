  "observations": {
    "math-flow-basic": "Both nodes contain all terms x squared+y squared=z squared, plus a+b over c+d with visible fraction bar. Arrow A to B, labels contained. Native font/box dimensions differ from browser host.",
    "math-flow-edge": "A to B relation visible, edge label sum has n above and k=1 below, then k at right. Grey mask contains all glyphs without clipping.",
    "math-flow-group": "Group frame contains alpha to beta and the math title. All native backends show bold upright Group and italic alpha/beta. Official title is math italic; official JSON confirms visible mathematical italic Unicode, despite original source using mathbf. Difference explicitly recorded.",
    "math-flow-literal": "HTMLlabelsfalse shows Literal $$x^2$$ as literal text on both sides; no lost dollar signs or accidental superscript interpretation.",
    "math-flow-matrix": "Both sides show parentheses enclosing 1 2 / 3 4 in two rows and two columns, arrow down to Matrix. Auto/GPU match native CPU content and hierarchy.",
    "math-flow-metadata": "Native visibly renders nu < y with all three symbols. Official source image instead shows malformed literal dollar/slash text and u on next line; official sourceProjection has embedded newline. This source-host defect is not called pixel equivalence.",
    "math-flow-mixed": "Area, pi r squared, units and Done are all readable, correct arrow down. Official text joins Area/formula/units without spaces while native preserves spaces; all native backends agree.",
    "math-flow-radical": "Cube-root index3, radical hook/vinculum and x over y all visible and contained. Native/browser radical geometry differs; no lost radical, fraction rule or numerator/denominator."
  },
